{
	"schemaVersion": 1,
	"id": "aiassist",
	"version": "${version}",
	"name": "AI Assistant",
	"description": "An AI-powered assistant for Minecraft. Ask questions and discover dynamically named structures.",
	"authors": [
		"YourNameHere"
	],
	"contact": {
		"homepage": "https://your-project-homepage.com/",
		"sources": "https://github.com/YourUser/YourRepo"
	},
	"license": "CC0-1.0",
	"icon": "assets/aiassist/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.aiassist.AiMod"
		],
		"client": [
			"com.aiassist.AiAssistClient"
		],
		"modmenu": [
			"com.aiassist.ModMenuIntegration"
		],
		"cardinal-components": [
			"com.aiassist.component.ModComponents"
		]
	},
	"mixins": [
		"aiassist.mixins.json",
		"aiassist.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.10",
		"minecraft": "~1.20.6",
		"java": ">=21",
		"fabric-api": "*",
		"cardinal-components-base": "*",
		"cardinal-components-entity": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"cardinal-components": [
			"aiassist:villager_data",
			"aiassist:player_dialogue",
			"aiassist:player_quest"
		]
	}
}