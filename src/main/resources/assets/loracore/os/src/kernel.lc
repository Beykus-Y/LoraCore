// ==========================================================
// LoraCore Kernel v1.0
// Safe Mode (No Strings, Explicit Memory Access)
// ==========================================================

// Константы BIOS (Zero Page)
const BIOS_VAR_GPU = 0x0400;

// Оффсеты регистров GPU (относительно конца VRAM)
const REG_CMD   = 0x04;
const REG_X     = 0x08;
const REG_Y     = 0x0C;
const REG_W     = 0x10;
const REG_H     = 0x14;
const REG_COLOR = 0x18;

// Команды GPU
const CMD_CLEAR = 1;
const CMD_FILL  = 2;
const CMD_TEXT  = 3;

// Цвета (0xAARRGGBB)
const COL_BG    = 0xFF202020; // Темно-серый фон
const COL_WIN   = 0xFFC0C0C0; // Окно (Серебро)
const COL_BAR   = 0xFF000080; // Заголовок (Синий)
const COL_TEXT  = 0xFFFFFFFF; // Белый текст

// Глобальная переменная для адреса регистров GPU
let gpu_regs_ptr = 0;

fn main() {
    init_gpu_driver();

    // 1. Рисуем рабочий стол
    gpu_clear(COL_BG);

    // 2. Рисуем Окно (X=50, Y=50, W=200, H=100)
    gpu_rect(50, 50, 200, 100, COL_WIN);

    // Заголовок окна
    gpu_rect(52, 52, 196, 18, COL_BAR);

    // 3. Пишем текст "LORA" по буквам (т.к. нет поддержки строк)
    // L=76, O=79, R=82, A=65
    gpu_char(120, 90, 76, 0xFF000000);
    gpu_char(128, 90, 79, 0xFF000000);
    gpu_char(136, 90, 82, 0xFF000000);
    gpu_char(144, 90, 65, 0xFF000000);

    // Бесконечный цикл ОС
    while (1) {
        // Idle loop
    }
}

fn init_gpu_driver() {
    // Читаем адрес, который нашел BIOS
    let base = mem[BIOS_VAR_GPU];

    // Прибавляем размер VRAM (480*270*4 = 0x7E900)
    // Внимание: если у тебя в эмуляторе другое разрешение,
    // измени эту константу!
    // Для 480x270 -> 0x7E900
    // Для 960x540 -> 0x1FA400
    let offset = 0x7E900;

    // Сохраняем итоговый адрес регистров в глобальную переменную
    gpu_regs_ptr = base + offset;
}

fn gpu_clear(color) {
    let regs = gpu_regs_ptr;

    // Пишем цвет в REG_COLOR (offset 24)
    mem[regs + REG_COLOR] = color;

    // Пишем команду в REG_CMD (offset 4)
    mem[regs + REG_CMD] = CMD_CLEAR;
}

fn gpu_rect(x, y, w, h, color) {
    let regs = gpu_regs_ptr;

    mem[regs + REG_X] = x;
    mem[regs + REG_Y] = y;
    mem[regs + REG_W] = w;
    mem[regs + REG_H] = h;
    mem[regs + REG_COLOR] = color;

    mem[regs + REG_CMD] = CMD_FILL;
}

fn gpu_char(x, y, code, color) {
    let regs = gpu_regs_ptr;

    mem[regs + REG_X] = x;
    mem[regs + REG_Y] = y;
    // Используем регистр W для передачи кода символа
    mem[regs + REG_W] = code;
    mem[regs + REG_COLOR] = color;

    mem[regs + REG_CMD] = CMD_TEXT;
}