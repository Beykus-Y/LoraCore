import "sys/layout.lc";

fn stack_init() {
    // В текущей реализации LoraC:
    set_stack_pointer(K_STACK_TOP);
    gpu_print(10, 30, "Stack: Initialized at 0x01FFFC", 0xFF00FF00);
}

