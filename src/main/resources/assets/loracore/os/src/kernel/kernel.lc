import "consts.lc";
import "globals.lc";
import "drivers/gpu.lc";
import "drivers/keyboard.lc";
import "drivers/hardware.lc";
import "stdlib/string.lc";
import "sys/shell.lc";
import "sys/filesystem.lc";

fn main() {
    init_hardware();
    terminal_reset();
    terminal_line("Native kernel ready", COL_OK);
    if (fs_init() == 1) {
        terminal_line("LoraFS mounted", COL_OK);
    } else {
        terminal_line("LoraFS unavailable", 0xFFFF8080);
    }
    terminal_line("Type help to begin", COL_DIM);
    shell_run();
}
